# ---------- Database (free: neon.tech) ----------
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Any long random text (keep it secret). Generate: https://generate-secret.vercel.app/32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Your live site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Razorpay (Dashboard → Account & Settings → API Keys) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard → Webhooks → the secret you choose there
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ---------- Images & PDFs: Cloudflare R2 (leave empty on your computer to save files locally) ----------
# R2 → Create bucket (e.g. csap-media) → Settings → Public access → copy the public URL
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# e.g. https://files.csap.co.in  or  https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# ---------- Emails (student "Forgot password") ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail, SMTP_PASS=16-letter App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
